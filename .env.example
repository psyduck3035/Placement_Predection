# Quick local demo: SQLite file database (no MySQL setup required)
USE_SQLITE_FALLBACK=1
SQLITE_PATH=placement_demo.db
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=1

# For MySQL, set USE_SQLITE_FALLBACK=0 and configure:
# USE_SQLITE_FALLBACK=0
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=placement_career
